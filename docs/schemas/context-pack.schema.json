{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aer.local/schemas/context-pack.schema.json",
  "title": "AER Context Pack",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "task_id",
    "engineering_ir_version",
    "policy_version",
    "budget",
    "items",
    "source_hashes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "engineering_ir_version": {
      "type": "integer",
      "minimum": 1
    },
    "repo_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "$ref": "budget.schema.json"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_type",
          "source_ref",
          "content_hash",
          "token_cost",
          "tier"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "token_cost": {
            "type": "integer",
            "minimum": 0
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "provenance": {
            "type": "object"
          },
          "selected_reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "omitted_high_rank_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

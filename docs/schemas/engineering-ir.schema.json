{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aer.local/schemas/engineering-ir.schema.json",
  "title": "AER Engineering IR",
  "type": "object",
  "required": ["schema_version", "project", "goals", "functional_requirements", "constraints", "invariants", "acceptance_criteria"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "project": {
      "type": "object",
      "required": ["id", "title", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "goals": {"type": "array", "items": {"$ref": "#/$defs/semanticItem"}},
    "non_goals": {"type": "array", "items": {"$ref": "#/$defs/semanticItem"}},
    "stakeholders": {"type": "array", "items": {"type": "object"}},
    "user_flows": {"type": "array", "items": {"type": "object"}},
    "functional_requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "quality_attributes": {"type": "array", "items": {"$ref": "#/$defs/semanticItem"}},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/semanticItem"}},
    "invariants": {"type": "array", "items": {"$ref": "#/$defs/semanticItem"}},
    "acceptance_criteria": {"type": "array", "items": {"$ref": "#/$defs/acceptanceCriterion"}},
    "interfaces": {"type": "array", "items": {"type": "object"}},
    "data_contracts": {"type": "array", "items": {"type": "object"}},
    "security_privacy": {"type": "array", "items": {"$ref": "#/$defs/semanticItem"}},
    "performance_targets": {"type": "array", "items": {"$ref": "#/$defs/semanticItem"}},
    "compatibility": {"type": "array", "items": {"$ref": "#/$defs/semanticItem"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/semanticItem"}},
    "research_findings": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string"},
        "id": {"type": "string"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    },
    "semanticItem": {
      "type": "object",
      "required": ["id", "statement"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}},
        "status": {"enum": ["proposed", "accepted", "deprecated"]},
        "risk": {"enum": ["low", "medium", "high", "critical"]}
      },
      "additionalProperties": true
    },
    "requirement": {
      "allOf": [
        {"$ref": "#/$defs/semanticItem"},
        {
          "type": "object",
          "properties": {
            "priority": {"enum": ["must", "should", "could"]},
            "verification_strategy": {"type": "array", "items": {"type": "string"}},
            "dependencies": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "acceptanceCriterion": {
      "allOf": [
        {"$ref": "#/$defs/semanticItem"},
        {
          "type": "object",
          "properties": {
            "requirement_refs": {"type": "array", "items": {"type": "string"}},
            "measure": {"type": "object"}
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "required": ["id", "choice", "authority"],
      "properties": {
        "id": {"type": "string"},
        "choice": {"type": "string"},
        "authority": {"enum": ["user", "system", "organization"]},
        "rationale": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reversibility": {"enum": ["easy", "moderate", "hard", "irreversible"]},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}
      },
      "additionalProperties": true
    },
    "unknown": {
      "type": "object",
      "required": ["id", "question", "uncertainty", "impact", "resolution"],
      "properties": {
        "id": {"type": "string"},
        "question": {"type": "string"},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "impact": {"type": "number", "minimum": 0, "maximum": 1},
        "resolution": {"enum": ["ask_user", "research", "system_default", "defer"]}
      },
      "additionalProperties": true
    }
  }
}

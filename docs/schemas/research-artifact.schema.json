{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aer.local/schemas/research-artifact.schema.json",
  "title": "AER Research Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "research_id",
    "question",
    "observed_at",
    "claims",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "research_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "freshness_policy": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "uri",
          "source_class",
          "retrieved_at",
          "content_hash"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "source_class": {
            "enum": [
              "official",
              "primary_research",
              "standard",
              "repository",
              "package_registry",
              "secondary",
              "user_generated",
              "unknown"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "content_hash": {
            "type": "string"
          },
          "sensitivity": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "statement",
          "source_refs",
          "confidence",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "enum": [
              "supported",
              "contested",
              "insufficient",
              "superseded"
            ]
          },
          "valid_as_of": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "counterevidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "promoted_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

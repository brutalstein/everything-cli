{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aer.local/schemas/work-result.schema.json",
  "title": "AER Work Result",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "summary",
    "changes",
    "new_facts",
    "new_hypotheses",
    "evidence_refs",
    "blocked_on",
    "recommended_next_actions",
    "claimed_requirement_coverage"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "artifact_hash": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "new_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "new_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "supported",
              "disproven",
              "superseded"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claimed_requirement_coverage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

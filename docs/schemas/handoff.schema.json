{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aer.local/schemas/handoff.schema.json",
  "title": "AER Handoff Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "task_id",
    "objective",
    "spec_version",
    "requested_action",
    "expected_output_contract"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "handoff_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "spec_version": {
      "type": "integer",
      "minimum": 1
    },
    "repo_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_state": {
      "type": "object"
    },
    "known_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relevant_context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_action": {
      "type": "string"
    },
    "budget": {
      "$ref": "budget.schema.json"
    },
    "expected_output_contract": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "supported",
            "disproven",
            "superseded"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aer.local/schemas/run.schema.json",
  "title": "AER Run State",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "state",
    "started_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "pending",
        "interviewing",
        "planning",
        "executing",
        "waiting_for_user",
        "waiting_for_permission",
        "verifying",
        "recovering",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "spec_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "repo_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "quality_mode": {
      "enum": [
        "economy",
        "balanced",
        "maximum-quality"
      ]
    },
    "budget": {
      "$ref": "budget.schema.json"
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
